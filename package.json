{
  "name": "uisdk-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env eval/run.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@ui-sdk/core": "0.1.0-beta.7",
    "@ui-sdk/react": "0.1.0-beta.7",
    "@web-kits/audio": "^0.2.0",
    "allo-font": "^1.0.0",
    "hono": "^4.13.19",
    "openai": "^7.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
